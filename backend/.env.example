# Backend configuration. Copy to backend/.env; never commit the result.
# Generate the two secrets with `make hash-password` and `make vault-key`.

CYLIST_ENVIRONMENT=dev
CYLIST_DATABASE_URL=postgresql+asyncpg://cylist:cylist@localhost:5432/cylist
CYLIST_DATA_DIR=./data
CYLIST_MAX_UPLOAD_MB=200
CYLIST_PASSWORD_HASH=
CYLIST_VAULT_KEY=
CYLIST_CORS_ORIGINS=["http://localhost:5173"]
CYLIST_SESSION_TTL_HOURS=720

# --- Logging ---------------------------------------------------------------
# The log always goes to stderr, which is what `make logs` and `make prod-logs`
# follow. These change how much of it there is, in what shape, and whether a
# copy is also kept in a file on the server.

# DEBUG, INFO, WARNING, ERROR or CRITICAL. DEBUG adds every static asset the
# browser fetches and every health check, so it is for a problem you are
# chasing rather than for leaving on.
CYLIST_LOG_LEVEL=INFO

# `text` to read, `json` for one object per line that a shipper or `jq` can
# parse. Deployments that keep the file are usually happier with json.
CYLIST_LOG_FORMAT=text

# The switch this whole section exists for. Set it true and the log is also
# written to a file under CYLIST_DATA_DIR/logs — inside the volume the
# deployment already mounts, so it survives `docker compose down`.
CYLIST_LOG_TO_FILE=false

# Where that file goes, if not the default of CYLIST_DATA_DIR/logs/cylist.log.
# CYLIST_LOG_FILE=/data/logs/cylist.log

# How much of it to keep: this many megabytes per file, this many rolled files
# behind the live one. 10 x (5 + 1) = 60 MB at most, whatever happens.
CYLIST_LOG_FILE_MAX_MB=10
CYLIST_LOG_FILE_BACKUPS=5
