# Backend configuration. Copy to backend/.env; never commit the result.
# Generate the two secrets with `make hash-password` and `make vault-key`.

CYLIST_ENVIRONMENT=dev
CYLIST_DATABASE_URL=postgresql+asyncpg://cylist:cylist@localhost:5432/cylist
CYLIST_DATA_DIR=./data
CYLIST_MAX_UPLOAD_MB=200
CYLIST_PASSWORD_HASH=
CYLIST_VAULT_KEY=
CYLIST_CORS_ORIGINS=["http://localhost:5173"]
CYLIST_SESSION_TTL_HOURS=720
