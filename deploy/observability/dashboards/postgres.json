          },
          "expr": "sum(rate(pg_stat_database_blks_hit{environment=\"$environment\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{environment=\"$environment\"}[5m])) + sum(rate(pg_stat_database_blks_read{environment=\"$environment\"}[5m])))",
