<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone, in a cloud backup or a device-to-device transfer.
  The app will hold an API token, and a token restored onto another device is
  a credential copied somewhere nobody chose. A new phone signs in again.
  backup_rules.xml says the same to Android 11 and older.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </device-transfer>
</data-extraction-rules>
